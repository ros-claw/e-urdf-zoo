<?xml version="1.0"?>
<robot name="inspire_hand_right">
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="meshes/visual/base_link.glb"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="meshes/collision/base_link.obj"/>
      </geometry>
    </collision>
  </link>
  <link name="right_index_proximal">
    <visual>
      <geometry>
        <mesh filename="meshes/visual/index_proximal.glb"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="meshes/collision/index_proximal.obj"/>
      </geometry>
    </collision>
  </link>
  <joint name="right_index_proximal_joint" type="revolute">
    <parent link="base_link"/>
    <child link="right_index_proximal"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="1.57" effort="1" velocity="1"/>
  </joint>
</robot>
